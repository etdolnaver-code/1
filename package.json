{
  "name": "mbco-safety-entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file=.env.local scripts/init.ts",
    "data:purge": "node --env-file=.env.local scripts/purge.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "format": "prettier --write app components lib scripts tests *.json *.ts *.mjs *.md"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "type": "module"
}
