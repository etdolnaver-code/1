# Node.js 24, 단일 인스턴스와 영속 디스크 필요
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/mbco.sqlite
# 32바이트 hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DATA_ENCRYPTION_KEY=
INITIAL_ADMIN_PASSWORD=1111
# 운영 HTTPS에서는 true, 로컬 http에서는 false
COOKIE_SECURE=false
# 프록시가 헤더를 덮어쓰도록 설정한 경우만 true
TRUST_PROXY=false
